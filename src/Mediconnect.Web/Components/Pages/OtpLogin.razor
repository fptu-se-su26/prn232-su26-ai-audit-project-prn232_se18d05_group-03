@page "/otp-login"
@attribute [AllowAnonymous]

<PageTitle>Đăng nhập bằng mã OTP – MediConnect</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="text-center mb-4">
            <span class="material-symbols-outlined" style="font-size:3rem;color:var(--color-primary)">mail</span>
            <h4 class="mt-3 mb-1">Đăng nhập bằng mã OTP</h4>
            <p class="text-muted mb-0" style="font-size:.85rem">Dùng cho tài khoản được tạo lúc tiếp nhận (bệnh nhân vãng lai) — nhập email đã đăng ký và mã OTP đã gửi qua email.</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2 mb-3" style="font-size:.82rem">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" placeholder="email@example.com" />
            </div>
            <div class="mb-4">
                <label class="form-label">Mã OTP</label>
                <InputText class="form-control" @bind-Value="_model.Code" placeholder="Nhập mã đã nhận qua email" />
            </div>
            <button type="submit" class="btn btn-primary btn-pill w-100" style="height:44px;font-size:.9rem" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                @(_loading ? "Đang xác thực..." : "Đăng nhập")
            </button>

            <p class="text-center text-muted mt-4 mb-0" style="font-size:.85rem">
                Có mật khẩu rồi?
                <a href="login" style="font-weight:600">Đăng nhập thường</a>
            </p>
        </EditForm>
    </div>
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailQuery { get; set; }

    private OtpLoginModel _model = new();
    private string? _error;
    private bool _loading;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(EmailQuery))
        {
            _model.Email = EmailQuery;
        }
    }

    private async Task HandleLogin()
    {
        _loading = true; _error = null;
        try { await Api.LoginWithOtp(_model.Email, _model.Code); Nav.NavigateTo("/", forceLoad: false); }
        catch (ApiClient.ApiException ex) { _error = ex.Message; }
        catch { _error = "Không thể kết nối đến máy chủ."; }
        finally { _loading = false; }
    }

    private class OtpLoginModel
    {
        public string Email { get; set; } = "";
        public string Code { get; set; } = "";
    }
}
