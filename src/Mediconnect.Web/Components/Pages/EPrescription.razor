@page "/e-prescription"
@attribute [Authorize(Roles = "Doctor,Nurse")]

<PageTitle>Đơn thuốc điện tử – MediConnect</PageTitle>

<div class="mb-4">
    <h4 class="mb-1 d-flex align-items-center gap-2">
        <span class="material-symbols-outlined" style="color:var(--color-primary);font-size:1.7rem">medication</span>
        Đơn thuốc điện tử
    </h4>
    <p class="text-muted mb-0">Tìm kiếm bệnh nhân để kê đơn thuốc trực tiếp.</p>
</div>

@if (_activeVisitId is not null)
{
    <EPrescriptionPanel VisitId="@_activeVisitId" DoctorId="@_staffProfileId!.Value" PatientId="@_activePatientId" PatientName="@_activePatientName" OnClose="Close" />
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-primary">person_search</span>
                        Tìm kiếm bệnh nhân để kê đơn
                    </h6>

                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white"><span class="material-symbols-outlined text-muted">search</span></span>
                        <input class="form-control" placeholder="Nhập tên bệnh nhân, sđt, mã BN..." @bind="_searchQuery" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
                        <button class="btn btn-primary" disabled="@_searching" @onclick="SearchPatients">
                            @(_searching ? "Đang tìm..." : "Tìm bệnh nhân")
                        </button>
                    </div>

                    @if (_error is not null)
                    {
                        <div class="alert alert-danger py-2 mb-3" style="font-size:.85rem">@_error</div>
                    }
                    @if (_staffProfileId is null && !_loadingStaff)
                    {
                        <div class="alert alert-warning py-2 mb-3" style="font-size:.85rem">Không tìm thấy hồ sơ nhân viên cho tài khoản này.</div>
                    }

                    @if (_searchResults.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2" style="max-height:420px;overflow-y:auto">
                            @foreach (var p in _searchResults)
                            {
                                <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center bg-light">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white bg-primary" style="width:40px;height:40px">
                                            @((p.Name ?? "?").Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold">@p.Name</div>
                                            <div class="text-muted small">
                                                @(string.IsNullOrEmpty(p.Phone) ? "" : $"SĐT: {p.Phone} • ")ID: @p.PatientId.ToString()[..8]...
                                            </div>
                                        </div>
                                    </div>
                                    <button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" disabled="@(_staffProfileId is null || _prescribingId == p.PatientId)" @onclick="() => SelectAndPrescribe(p)">
                                        <span class="material-symbols-outlined" style="font-size:.95rem">edit_note</span>
                                        Kê đơn thuốc
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else if (_hasSearched)
                    {
                        <div class="text-center text-muted py-4 border rounded-3 border-dashed">
                            <span class="material-symbols-outlined d-block mb-1 text-muted" style="font-size:2rem">person_off</span>
                            Không tìm thấy bệnh nhân nào khớp với từ khóa "@_searchQuery".
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100" style="border-style:dashed">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <span class="material-symbols-outlined mb-3 text-primary" style="font-size:3.5rem">medication</span>
                    <h5 class="mb-2">Kê đơn thuốc điện tử</h5>
                    <p class="text-muted mb-4" style="font-size:.85rem">
                        Hệ thống tự động liên kết kho dược, gợi ý liều lượng và cảnh báo tương tác thuốc tự động.
                    </p>
                    <div class="d-flex flex-column gap-2 w-100">
                        @foreach (var f in _features)
                        {
                            <div class="d-flex align-items-center gap-2 p-2 rounded-3 text-start" style="background:var(--color-surface-container-low)">
                                <span class="material-symbols-outlined text-primary" style="font-size:1.1rem">@f.Icon</span>
                                <span style="font-size:.82rem;font-weight:500">@f.Label</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private TokenState Token { get; set; } = default!;

    private Guid? _staffProfileId;
    private bool _loadingStaff = true;
    private bool _searching;
    private bool _hasSearched;
    private Guid? _prescribingId;
    private string? _error;
    private string _searchQuery = "";
    private string? _activeVisitId;
    private Guid? _activePatientId;
    private string _activePatientName = "Bệnh nhân";

    private class PatientSearchResult
    {
        public Guid PatientId { get; set; }
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    private List<PatientSearchResult> _searchResults = new();

    private static readonly (string Icon, string Label)[] _features =
    {
        ("search", "Tìm thuốc theo kho dược thực tế"),
        ("warning", "Cảnh báo dị ứng tự động"),
        ("inventory_2", "Kiểm tra tồn kho trước khi kê"),
        ("send", "Gửi đơn thuốc trực tiếp đến nhà thuốc"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var directory = (await Api.GetStaffDirectory()) ?? new();
            _staffProfileId = directory.FirstOrDefault(s => s.UserId == Token.User?.Id)?.Id;
            await LoadRecentPatients();
        }
        catch (ApiClient.ApiException ex) { _error = ex.Message; }
        finally { _loadingStaff = false; }
    }

    private async Task LoadRecentPatients()
    {
        try
        {
            var patients = (await Api.GetAllPatients()) ?? new();
            var users = (await Api.GetUserAccounts()) ?? new();
            var userDict = users.ToDictionary(u => u.Id, u => u);

            _searchResults = patients.Take(5).Select(p =>
            {
                var userAcc = userDict.GetValueOrDefault(p.UserAccountId);
                return new PatientSearchResult
                {
                    PatientId = p.Id,
                    Name = userAcc?.FullName ?? "Bệnh nhân",
                    Phone = userAcc?.PhoneNumber ?? ""
                };
            }).ToList();
        }
        catch { }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchPatients();
    }

    private async Task SearchPatients()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            await LoadRecentPatients();
            _hasSearched = false;
            return;
        }

        _searching = true;
        _hasSearched = true;
        _searchResults = new();
        var q = _searchQuery.Trim().ToLower();

        try
        {
            var patients = (await Api.GetAllPatients()) ?? new();
            var users = (await Api.GetUserAccounts()) ?? new();
            var userDict = users.ToDictionary(u => u.Id, u => u);

            foreach (var p in patients)
            {
                var userAcc = userDict.GetValueOrDefault(p.UserAccountId);
                var name = userAcc?.FullName ?? "Bệnh nhân";
                var phone = userAcc?.PhoneNumber ?? "";
                var pIdStr = p.Id.ToString().ToLower();

                if (name.ToLower().Contains(q) || phone.Contains(q) || pIdStr.Contains(q))
                {
                    _searchResults.Add(new PatientSearchResult
                    {
                        PatientId = p.Id,
                        Name = name,
                        Phone = phone
                    });
                }
            }
        }
        catch { }
        finally { _searching = false; }
    }

    private async Task SelectAndPrescribe(PatientSearchResult p)
    {
        _prescribingId = p.PatientId;
        _error = null;
        try
        {
            var doctorId = _staffProfileId ?? Token.User!.Id;
            var allVisits = await Api.GetOutpatientVisits();
            var existingVisit = allVisits?.FirstOrDefault(v => v.PatientId == p.PatientId);

            var clinics = await Api.GetAllClinics();
            var defaultClinicId = clinics?.FirstOrDefault()?.Id ?? Guid.Empty;

            var visit = existingVisit ?? await Api.CreateOutpatientVisit(new OutpatientVisitWriteDto
            {
                PatientId = p.PatientId,
                DoctorId = doctorId,
                ClinicId = defaultClinicId,
                VisitDate = DateTime.UtcNow,
                Status = VisitStatus.InProgress,
            });

            if (visit is not null)
            {
                _activeVisitId = visit.Id.ToString();
                _activePatientId = p.PatientId;
                _activePatientName = p.Name;
            }
        }
        catch (ApiClient.ApiException ex) { _error = ex.Message; }
        catch { _error = "Lỗi khi mở phiên kê đơn thuốc cho bệnh nhân."; }
        finally { _prescribingId = null; }
    }

    private void Close()
    {
        _activeVisitId = null;
        _activePatientId = null;
        _activePatientName = "Bệnh nhân";
    }
}
