@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Đăng nhập – MediConnect</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-brand">
            <span class="login-logo material-symbols-outlined">local_hospital</span>
            <h4 class="mb-1">Đăng nhập</h4>
            <p class="text-muted mb-0">Nhập thông tin tài khoản để tiếp tục</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2 mb-3" style="font-size:.82rem">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" placeholder="email@mediconnect.local" autocomplete="username" />
            </div>
            <div class="mb-4">
                <label class="form-label">Mật khẩu</label>
                <InputText type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-pill w-100" style="height:44px;font-size:.9rem" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                @(_loading ? "Đang đăng nhập..." : "Đăng nhập")
            </button>
        </EditForm>

        <p class="text-center text-muted mt-4 mb-0" style="font-size:.85rem">
            Chưa có tài khoản?
            <a href="register" style="font-weight:600">Đăng ký</a>
        </p>

        <div class="login-hint">
            <div class="login-hint-title">Tài khoản demo — bấm để điền nhanh</div>
            <div class="login-hint-grid">
                @foreach (var a in _demoAccounts)
                {
                    <button type="button" class="login-hint-item" @onclick="() => Fill(a.Email, a.Password)">
                        <span class="login-hint-role">@a.Role</span>
                        <span class="login-hint-email">@a.Email</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private LoginModel _model = new();
    private string? _error;
    private bool _loading;

    private record DemoAccount(string Role, string Email, string Password);

    private static readonly DemoAccount[] _demoAccounts =
    {
        new("Admin",   "admin@mediconnect.local",   "Admin@123"),
        new("Doctor",  "doctor@mediconnect.local",  "Doctor@123"),
        new("Nurse",   "nurse@mediconnect.local",   "Nurse@123"),
        new("Lab",     "lab@mediconnect.local",     "Lab@123"),
        new("Patient", "patient@mediconnect.local", "Patient@123"),
    };

    private void Fill(string email, string password)
    {
        _model.Email = email;
        _model.Password = password;
    }

    private async Task HandleLogin()
    {
        _loading = true; _error = null;
        try { await Api.LoginAsync(_model.Email, _model.Password); Nav.NavigateTo("/", forceLoad: false); }
        catch (ApiClient.ApiException ex) { _error = ex.Message; }
        catch { _error = "Không thể kết nối đến máy chủ."; }
        finally { _loading = false; }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
